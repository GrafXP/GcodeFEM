<Window x:Class="GcodeFem.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hx="http://helix-toolkit.org/wpf/SharpDX"
        xmlns:local="clr-namespace:GcodeFem.App"
        Title="GcodeFem" Width="1400" Height="900">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />
        <local:EnumEqualsConverter x:Key="Is" />
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Field" TargetType="FrameworkElement">
            <Setter Property="Margin" Value="0,3" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF52514E" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
        <Style x:Key="Tab" TargetType="RadioButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
            <Setter Property="Padding" Value="14,5" />
            <Setter Property="Margin" Value="0,0,4,0" />
        </Style>
    </Window.Resources>

    <DockPanel Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding Status}" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="{Binding Caption}" Foreground="#FF52514E" />
            </StatusBarItem>
        </StatusBar>

        <ScrollViewer DockPanel.Dock="Left" Width="330" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="10">
                <Button Content="Open model…" Click="OpenModel_Click" Padding="10,4" HorizontalAlignment="Left" />
                <TextBlock Text="{Binding ModelName}" Style="{StaticResource Hint}" />

                <GroupBox Header="Print" Margin="0,8,0,0" Padding="6,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="62" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Rotation" Style="{StaticResource Label}" ToolTip="Degrees about X, then Y, then Z" />
                        <UniformGrid Grid.Column="1" Columns="3" Style="{StaticResource Field}" ToolTip="Degrees about X, then Y, then Z">
                            <TextBox Text="{Binding RotationX}" Margin="0,0,4,0" />
                            <TextBox Text="{Binding RotationY}" Margin="0,0,4,0" />
                            <TextBox Text="{Binding RotationZ}" />
                        </UniformGrid>
                        <TextBlock Grid.Row="1" Text="Printer" Style="{StaticResource Label}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Printer}" TextWrapping="Wrap" Style="{StaticResource Field}" />
                        <TextBlock Grid.Row="2" Text="Process" Style="{StaticResource Label}" />
                        <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding Processes}" SelectedItem="{Binding Process}" Style="{StaticResource Field}" />
                        <TextBlock Grid.Row="3" Text="Filament" Style="{StaticResource Label}" />
                        <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding Filaments}" SelectedItem="{Binding Filament}" Style="{StaticResource Field}" />
                        <Button Grid.Row="4" Grid.Column="1" Content="Slice" Command="{Binding SliceCommand}" Padding="10,4" Margin="0,6,0,2" HorizontalAlignment="Left" />
                    </Grid>
                </GroupBox>

                <GroupBox Header="Load, in the print's directions (Z up from the bed)" Margin="0,8,0,0" Padding="6,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="62" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Clamp" Style="{StaticResource Label}" ToolTip="The side of the printed part that is held" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding Faces}" DisplayMemberPath="Label" SelectedItem="{Binding FixFace}" Style="{StaticResource Field}" />
                        <TextBlock Grid.Row="1" Text="Force, N" Style="{StaticResource Label}" ToolTip="X, Y, Z in newtons, spread over the side opposite the clamp" />
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Force}" Style="{StaticResource Field}" ToolTip="X, Y, Z in newtons, spread over the side opposite the clamp" />
                        <TextBlock Grid.Row="2" Text="Mesh" Style="{StaticResource Label}" />
                        <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding Levels}" DisplayMemberPath="Label" SelectedItem="{Binding Level}" Style="{StaticResource Field}" />
                        <Button Grid.Row="3" Grid.Column="1" Content="Solve" Command="{Binding SolveCommand}" Padding="10,4" Margin="0,6,0,2" HorizontalAlignment="Left" />
                    </Grid>
                </GroupBox>

                <GroupBox Header="Layers" Margin="0,8,0,0" Padding="6,4" Visibility="{Binding HasLayers, Converter={StaticResource Visible}}">
                    <StackPanel>
                        <TextBlock Text="{Binding LayerText}" TextWrapping="Wrap" />
                        <Slider Minimum="1" Maximum="{Binding LayerCount}" Value="{Binding LayerHigh}" IsSnapToTickEnabled="True" TickFrequency="1"
                                SmallChange="1" LargeChange="10" Margin="0,6,0,0" ToolTip="Last layer shown" />
                        <Slider Minimum="1" Maximum="{Binding LayerCount}" Value="{Binding LayerLow}" IsSnapToTickEnabled="True" TickFrequency="1"
                                SmallChange="1" LargeChange="10" Margin="0,4,0,0" ToolTip="First layer shown" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Toolpaths" Margin="0,8,0,0" Padding="6,4" Visibility="{Binding IsToolpathView, Converter={StaticResource Visible}}">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock Text="Colour by" VerticalAlignment="Center" Width="62" />
                            <ComboBox ItemsSource="{Binding Colourings}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Colouring}" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding LineTypes}" Margin="0,6,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsShown}" Margin="0,2">
                                        <StackPanel Orientation="Horizontal">
                                            <Rectangle Width="12" Height="12" RadiusX="2" RadiusY="2" Fill="{Binding Swatch}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Label}" Margin="6,0,0,0" />
                                        </StackPanel>
                                    </CheckBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <CheckBox Content="Thin lines instead of full beads" IsChecked="{Binding ThinLines}" Margin="0,8,0,2"
                                  ToolTip="Much less to draw: for big parts on a weak graphics card" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Result" Margin="0,8,0,0" Padding="6,4" Visibility="{Binding IsResultView, Converter={StaticResource Visible}}">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock Text="Colour by" VerticalAlignment="Center" Width="62" />
                            <ComboBox ItemsSource="{Binding Quantities}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Quantity}" />
                        </DockPanel>
                        <TextBlock Text="{Binding ScaleTopText}" Margin="0,8,0,2" />
                        <Slider Minimum="5" Maximum="100" Value="{Binding ScaleTop}" SmallChange="1" LargeChange="10" />
                        <TextBlock Text="{Binding DeformationText}" Margin="0,8,0,2" />
                        <Slider Minimum="0" Maximum="1" Value="{Binding Deformation}" SmallChange="0.05" LargeChange="0.2" />
                        <CheckBox Content="Outline the coarse elements" IsChecked="{Binding ShowElements}" Margin="0,8,0,2"
                                  ToolTip="Elements of 4 x 4 x 4 cells and larger. Where there are no outlines, the mesh is fine." />
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" Margin="8,8,8,6">
                <RadioButton Content="Model" Style="{StaticResource Tab}"
                             IsChecked="{Binding View, Converter={StaticResource Is}, ConverterParameter=Model}" />
                <RadioButton Content="Toolpaths" Style="{StaticResource Tab}" IsEnabled="{Binding HasPrint}"
                             IsChecked="{Binding View, Converter={StaticResource Is}, ConverterParameter=Toolpaths}" />
                <RadioButton Content="Cells" Style="{StaticResource Tab}" IsEnabled="{Binding HasPrint}"
                             IsChecked="{Binding View, Converter={StaticResource Is}, ConverterParameter=Cells}" />
                <RadioButton Content="Results" Style="{StaticResource Tab}" IsEnabled="{Binding HasResult}"
                             IsChecked="{Binding View, Converter={StaticResource Is}, ConverterParameter=Results}" />
            </StackPanel>

            <Grid Grid.Row="1">
                <!-- Everything is shown as it will be printed: Z up, the bed at the bottom. -->
                <hx:Viewport3DX x:Name="Viewport"
                                EffectsManager="{Binding EffectsManager}"
                                Camera="{Binding Camera}"
                                BackgroundColor="#FF1A1A19"
                                ModelUpDirection="0,0,1"
                                MSAA="Four"
                                ShowViewCube="True"
                                ShowCoordinateSystem="True">
                    <!-- A light at the camera, so every face in view is lit in its own colour. -->
                    <hx:DirectionalLight3D Direction="{Binding Camera.LookDirection}" Color="#FFC8C8C8" />
                    <hx:DirectionalLight3D Direction="-0.3,0.5,-1" Color="#FF505050" />
                    <hx:AmbientLight3D Color="#FF303030" />

                    <hx:LineGeometryModel3D Geometry="{Binding BedGrid}" Color="#FF383835" Thickness="1" IsHitTestVisible="False" />
                    <hx:MeshGeometryModel3D Geometry="{Binding ModelGeometry}" Material="{Binding ModelMaterial}" IsHitTestVisible="False" />
                    <hx:MeshGeometryModel3D Geometry="{Binding BeadGeometry}" Material="{Binding ColouredMaterial}" IsHitTestVisible="False" />
                    <hx:LineGeometryModel3D Geometry="{Binding BeadLines}" Color="White" Thickness="1.5" IsHitTestVisible="False" />
                    <hx:MeshGeometryModel3D Geometry="{Binding CellGeometry}" Material="{Binding ColouredMaterial}" IsHitTestVisible="False" />
                    <!-- Coarse elements lie where the values are low and the cells dark, so outlines a little lighter than those show. -->
                    <hx:LineGeometryModel3D Geometry="{Binding ElementLines}" Color="#FF898781" Thickness="0.8" DepthBias="-100" IsHitTestVisible="False" />
                </hx:Viewport3DX>

                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12,12,12,0" Padding="12,10" CornerRadius="4" MaxWidth="300"
                        Background="#E61A1A19" BorderBrush="#1AFFFFFF" BorderThickness="1"
                        Visibility="{Binding HasLegend, Converter={StaticResource Visible}}">
                    <StackPanel>
                        <TextBlock Text="{Binding LegendTitle}" Foreground="#FFC3C2B7" TextWrapping="Wrap" />
                        <ItemsControl ItemsSource="{Binding LegendEntries}" Margin="0,4,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                        <Rectangle Width="12" Height="12" RadiusX="2" RadiusY="2" Fill="{Binding Swatch}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Label}" Foreground="White" Margin="8,0,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Grid Height="{x:Static local:MainViewModel.LegendBarHeight}" Margin="0,10,0,8"
                              Visibility="{Binding HasLegendScale, Converter={StaticResource Visible}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Rectangle Fill="{Binding LegendScale}" RadiusX="2" RadiusY="2" />
                            <ItemsControl Grid.Column="1" ItemsSource="{Binding LegendTicks}" Margin="8,0,0,0" MinWidth="120">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Top" Value="{Binding Top}" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Text}" Foreground="White" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="2" Margin="8" Visibility="{Binding IsResultView, Converter={StaticResource Visible}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="{Binding ResultSummary}" TextWrapping="Wrap" />
                    <Border Background="#FFFDF3D7" BorderBrush="#FFFAB219" BorderThickness="1" CornerRadius="3" Padding="8,6" Margin="0,8,0,0"
                            Visibility="{Binding HasResultWarning, Converter={StaticResource Visible}}">
                        <DockPanel>
                            <TextBlock Text="&#x26A0;" FontWeight="Bold" Margin="0,0,8,0" />
                            <TextBlock TextWrapping="Wrap">
                                <Run Text="Do not rely on these numbers." FontWeight="SemiBold" />
                                <LineBreak />
                                <Run Text="{Binding ResultWarning, Mode=OneWay}" />
                            </TextBlock>
                        </DockPanel>
                    </Border>
                </StackPanel>
                <DataGrid Grid.Column="1" ItemsSource="{Binding Passes}" SelectedIndex="{Binding Pass}" AutoGenerateColumns="False" IsReadOnly="True"
                          SelectionMode="Single" HeadersVisibility="Column" CanUserSortColumns="False" CanUserReorderColumns="False"
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#FFE1E0D9" MaxHeight="170" VerticalAlignment="Top"
                          ToolTip="Select a pass to see the mesh and the stresses as they were after it">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Pass" Binding="{Binding Pass}" />
                        <DataGridTextColumn Header="Elements by size, bead cells first" Binding="{Binding Elements}" />
                        <DataGridTextColumn Header="Unknowns" Binding="{Binding Unknowns}" />
                        <DataGridTextColumn Header="Iterations" Binding="{Binding Iterations}" />
                        <DataGridTextColumn Header="Max von Mises, MPa" Binding="{Binding MaxVonMises}" />
                        <DataGridTextColumn Header="Peak lies in" Binding="{Binding PeakIn}" />
                        <DataGridTextColumn Header="Time, s" Binding="{Binding Seconds}" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
