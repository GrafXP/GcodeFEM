<Window x:Class="GcodeFem.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hx="http://helix-toolkit.org/wpf/SharpDX"
        Title="GcodeFem" Width="1200" Height="800">
    <DockPanel>
        <ToolBar DockPanel.Dock="Top">
            <Button Content="Open STL…" Click="OpenStl_Click" />
        </ToolBar>
        <StatusBar DockPanel.Dock="Bottom">
            <TextBlock Text="{Binding Status}" />
        </StatusBar>

        <!-- Z is up, matching the print frame. -->
        <hx:Viewport3DX x:Name="Viewport"
                        EffectsManager="{Binding EffectsManager}"
                        BackgroundColor="#FF1E2227"
                        ModelUpDirection="0,0,1"
                        ShowViewCube="True"
                        ShowCoordinateSystem="True">
            <hx:Viewport3DX.Camera>
                <hx:PerspectiveCamera Position="60,-60,50"
                                      LookDirection="-50,50,-40"
                                      UpDirection="0,0,1"
                                      NearPlaneDistance="0.1"
                                      FarPlaneDistance="10000" />
            </hx:Viewport3DX.Camera>

            <hx:AmbientLight3D Color="#FF404040" />
            <hx:DirectionalLight3D Direction="-0.5,0.7,-1" Color="#FFE0E0E0" />
            <hx:DirectionalLight3D Direction="0.6,-0.4,0.5" Color="#FF606060" />

            <hx:MeshGeometryModel3D Geometry="{Binding PartGeometry}"
                                    Material="{x:Static hx:PhongMaterials.LightGray}" />
        </hx:Viewport3DX>
    </DockPanel>
</Window>
