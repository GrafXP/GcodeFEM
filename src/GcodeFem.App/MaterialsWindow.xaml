<Window x:Class="GcodeFem.App.MaterialsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GcodeFem.App"
        Title="Materials" Width="1320" Height="840" MinWidth="900" MinHeight="560" WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />
        <Style x:Key="Cell" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="CellEdit" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Padding" Value="4,2" />
        </Style>
        <Style x:Key="FormLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <!-- The window's own background is not part of its content, which a screenshot is of. -->
    <DockPanel Background="{StaticResource WindowBrush}">
        <!-- The library. Unsaved changes in the form lock it, so that picking another material cannot lose them. -->
        <Border DockPanel.Dock="Left" Width="290" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="18,20,12,16">
                <TextBlock DockPanel.Dock="Top" Text="Materials" Style="{StaticResource PageTitle}" />
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="0,4,6,14" Text="{Binding Directory, StringFormat='The material files in {0}'}" />
                <StackPanel DockPanel.Dock="Bottom" Margin="0,12,6,0">
                    <Button Style="{StaticResource PrimaryButton}" local:Look.Icon="&#xE8B5;" Content="Import a data sheet…" Click="Import_Click" IsEnabled="{Binding IsUnchanged}"
                            ToolTip="Reads a technical data sheet (PDF) into the form. Bambu Lab's sheets are filled in by themselves; others are typed in with the sheet alongside." />
                    <Button local:Look.Icon="&#xE710;" Content="New, to fill in by hand" Command="{Binding NewCommand}" Padding="12,7" Margin="0,8,0,0" IsEnabled="{Binding IsUnchanged}" />
                </StackPanel>
                <ListBox ItemsSource="{Binding Materials}" SelectedItem="{Binding Selected}" IsEnabled="{Binding IsUnchanged}" Margin="-6,0,0,0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Note}" Foreground="{StaticResource TextMutedBrush}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <DockPanel Margin="22,20,22,16">
            <DockPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
                <Button DockPanel.Dock="Right" Content="Close" Click="Close_Click" Padding="16,8" Margin="8,0,0,0" VerticalAlignment="Bottom" />
                <Button DockPanel.Dock="Right" Content="Discard changes" Command="{Binding DiscardCommand}" Padding="14,8" Margin="8,0,0,0" VerticalAlignment="Bottom" />
                <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Save" Command="{Binding SaveCommand}" Padding="24,8" Margin="8,0,0,0"
                        VerticalAlignment="Bottom" IsDefault="True" />
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="96">
                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding MessageIsError}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </ScrollViewer>
            </DockPanel>

            <Border DockPanel.Dock="Top" Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="130" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Name" Style="{StaticResource FormLabel}" />
                    <TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,4" />
                    <TextBlock Grid.Column="2" Text="Vendor" Style="{StaticResource FormLabel}" Margin="16,0,10,0" />
                    <TextBox Grid.Column="3" Text="{Binding Vendor, UpdateSourceTrigger=PropertyChanged}" Margin="0,4" />
                    <TextBlock Grid.Column="4" Text="Type" Style="{StaticResource FormLabel}" Margin="16,0,10,0" ToolTip="The filament type as Bambu Studio names it: PLA, PETG, PA-CF, …" />
                    <TextBox Grid.Column="5" Text="{Binding Type, UpdateSourceTrigger=PropertyChanged}" Margin="0,4" ToolTip="The filament type as Bambu Studio names it: PLA, PETG, PA-CF, …" />

                    <TextBlock Grid.Row="1" Text="For the filaments" Style="{StaticResource FormLabel}" />
                    <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="5" Text="{Binding Filaments, UpdateSourceTrigger=PropertyChanged}" Margin="0,4"
                             ToolTip="The filaments as Bambu Studio names them, several separated by a semicolon. A name without the printer (&quot;Bambu PLA Basic&quot;) covers that filament on every printer; one with it (&quot;eSun PLA+ @A1 max&quot;) covers that preset alone." />
                    <CheckBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="5" Content="{Binding StandInText}" IsChecked="{Binding StandsInForType}" Margin="0,8,0,6"
                              ToolTip="A filament that no material names is solved with the material that stands in for its type, and the result says so. Only one material can stand in for a type." />

                    <TextBlock Grid.Row="3" Text="Source" Style="{StaticResource FormLabel}" />
                    <DockPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="5" Margin="0,4">
                        <Button DockPanel.Dock="Right" local:Look.Icon="&#xE8A7;" Content="Open the data sheet" Click="OpenDocument_Click" Margin="10,0,0,0"
                                Visibility="{Binding HasDocument, Converter={StaticResource Visible}}" />
                        <TextBlock Text="{Binding DocumentText}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                </Grid>
            </Border>

            <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                <TextBlock DockPanel.Dock="Left" Width="120" Text="The specimens" Style="{StaticResource FormLabel}" VerticalAlignment="Top" Margin="0,6,0,0"
                           ToolTip="How the specimens behind the values were printed and treated. The values across the layers hold for these conditions." />
                <TextBox Text="{Binding SpecimenNote, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="False" MinLines="2" MaxLines="3"
                         VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" />
            </DockPanel>
            <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Hint}" Margin="0,10,0,0"
                       Text="Every value says where it is from: a source (&quot;tds&quot; is the data sheet above) with its page, or the reason why it is assumed, never both. A row without a value is a property the material does not give. &quot;In the plane&quot; is measured on a specimen printed lying flat, &quot;across the layers&quot; on one printed standing up." />

            <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="1">
                <DataGrid ItemsSource="{Binding Rows}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False"
                          CanUserReorderColumns="False" SelectionMode="Single" SelectionUnit="Cell" RowHeight="30">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Property" Binding="{Binding Label, Mode=OneWay}" IsReadOnly="True" Width="250" ElementStyle="{StaticResource Cell}" />
                        <DataGridTextColumn Header="Value" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="74" ElementStyle="{StaticResource Cell}" EditingElementStyle="{StaticResource CellEdit}" />
                        <DataGridTextColumn Header="±" Binding="{Binding Spread, UpdateSourceTrigger=PropertyChanged}" Width="54" ElementStyle="{StaticResource Cell}" EditingElementStyle="{StaticResource CellEdit}" />
                        <DataGridTextColumn Header="Unit" Binding="{Binding Unit, Mode=OneWay}" IsReadOnly="True" Width="58" ElementStyle="{StaticResource Cell}" />
                        <DataGridTextColumn Header="Test method" Binding="{Binding Method, UpdateSourceTrigger=PropertyChanged}" Width="140" ElementStyle="{StaticResource Cell}" EditingElementStyle="{StaticResource CellEdit}" />
                        <DataGridTextColumn Header="Source" Binding="{Binding Source, UpdateSourceTrigger=PropertyChanged}" Width="74" ElementStyle="{StaticResource Cell}" EditingElementStyle="{StaticResource CellEdit}" />
                        <DataGridTextColumn Header="Page" Binding="{Binding Page, UpdateSourceTrigger=PropertyChanged}" Width="50" ElementStyle="{StaticResource Cell}" EditingElementStyle="{StaticResource CellEdit}" />
                        <DataGridTextColumn Header="Or assumed, because" Binding="{Binding Assumed, UpdateSourceTrigger=PropertyChanged}" Width="*" EditingElementStyle="{StaticResource CellEdit}">
                            <DataGridTextColumn.ElementStyle>
                                <!-- A reason is a sentence; what does not fit the cell is in its tooltip. -->
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Cell}">
                                    <Setter Property="ToolTip" Value="{Binding Assumed}" />
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </DockPanel>
    </DockPanel>
</Window>
